<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <!-- Release tags override Version through -p:Version; this is the local default. -->
    <Version Condition="'$(Version)' == ''">0.1.1</Version>
    <AssemblyVersion>$([System.Text.RegularExpressions.Regex]::Match('$(Version)', '^\d+\.\d+\.\d+').Value).0</AssemblyVersion>
    <FileVersion>$(AssemblyVersion)</FileVersion>
    <InformationalVersion>$(Version)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Product>PaneShift</Product>
    <Description>Keyboard-first window management for Windows</Description>
    <AssemblyTitle>Keyboard-first window management for Windows</AssemblyTitle>
    <Company>Kenan Kasumović</Company>
    <Authors>Kenan Kasumović</Authors>
    <Copyright>Copyright © 2026 Kenan Kasumović</Copyright>
    <RepositoryUrl>https://github.com/Ken5998/PaneShift</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>
</Project>

<Window x:Class="PaneShift.App.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PaneShift.App.Settings"
        Title="PaneShift — Settings" Width="860" Height="720" MinWidth="720" MinHeight="580"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource CanvasBrush}"
        Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI" FontSize="14"
        UseLayoutRounding="True" Closing="OnClosing">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVisibility"/>
        <Style TargetType="Button" x:Key="ButtonStyle">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource StrokeBrush}"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter TargetName="Border" Property="BorderThickness" Value="2"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource ButtonStyle}"/>
        <Style TargetType="local:ShortcutRecorder" BasedOn="{StaticResource ButtonStyle}"/>
        <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
        <Style TargetType="Label"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/></Style>
        <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/></Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource StrokeBrush}"/>
            <Setter Property="Padding" Value="8"/>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>
        <Style x:Key="Heading" TargetType="TextBlock"><Setter Property="FontSize" Value="18"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,12"/></Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="Tab" Padding="20,12" Margin="0,0,8,8" CornerRadius="7" Background="Transparent">
                        <ContentPresenter x:Name="HeaderPresenter" ContentSource="Header" RecognizesAccessKey="True" TextElement.Foreground="{DynamicResource MutedBrush}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True"><Setter TargetName="Tab" Property="Background" Value="{DynamicResource CardBrush}"/><Setter TargetName="HeaderPresenter" Property="TextElement.Foreground" Value="{DynamicResource AccentBrush}"/><Setter TargetName="HeaderPresenter" Property="TextElement.FontWeight" Value="SemiBold"/></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Tab" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter TargetName="Tab" Property="BorderThickness" Value="1"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="28,24,28,20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,24">
            <Image x:Name="BrandIcon" Width="48" Height="48" Margin="0,0,16,0" RenderOptions.BitmapScalingMode="HighQuality"/>
            <StackPanel><TextBlock Text="PaneShift" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="Keyboard-first window management" Foreground="{DynamicResource MutedBrush}"/></StackPanel>
        </DockPanel>
        <Border Grid.Row="1" Style="{StaticResource Card}" Visibility="{Binding HasExternalChange, Converter={StaticResource BoolVisibility}}">
            <DockPanel><Button DockPanel.Dock="Right" Content="Reload into this window" Click="ReloadDraft" Margin="16,0,0,0"/><TextBlock Text="Settings changed externally. Your unsaved edits are preserved." VerticalAlignment="Center"/></DockPanel>
        </Border>
        <TabControl Grid.Row="2" Background="Transparent" BorderThickness="0" Padding="0" Foreground="{DynamicResource TextBrush}">
            <TabItem Header="_Shortcuts">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,8,12,0">
                    <StackPanel>
                        <TextBlock Text="Choose a field, then press a modifier and a key. Escape cancels recording; Clear disables a shortcut." Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,16"/>
                        <ItemsControl ItemsSource="{Binding Groups}">
                            <ItemsControl.ItemTemplate><DataTemplate>
                                <Border Style="{StaticResource Card}"><StackPanel>
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource Heading}"/>
                                    <ItemsControl ItemsSource="{Binding Rows}"><ItemsControl.ItemTemplate><DataTemplate>
                                        <Grid Margin="0,5"><Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition Width="*"/><ColumnDefinition Width="230"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <local:LayoutGlyph Action="{Binding Action}" Width="42" Height="28" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                            <local:ShortcutRecorder Grid.Column="2" Chord="{Binding Chord, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding Name}"/>
                                            <Button Grid.Column="3" Content="Clear" Command="{Binding ClearCommand}" Margin="8,0,0,0" Padding="10,8" AutomationProperties.Name="{Binding Name, StringFormat=Clear {0} shortcut}"/>
                                        </Grid>
                                    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                </StackPanel></Border>
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="Reset shortcuts to defaults" Click="ResetShortcuts" HorizontalAlignment="Left" Margin="0,0,0,16"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="_Layout">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,8,12,0"><StackPanel>
                    <Border Style="{StaticResource Card}"><StackPanel>
                        <TextBlock Text="Window spacing" Style="{StaticResource Heading}"/>
                        <DockPanel Margin="0,0,0,12"><Label Content="_Gap between windows (px)" Target="{Binding ElementName=GapInput}" VerticalAlignment="Center"/><TextBox x:Name="GapInput" Text="{Binding GapText, UpdateSourceTrigger=PropertyChanged}" Width="110" HorizontalAlignment="Right" AutomationProperties.Name="Gap between windows in pixels"/></DockPanel>
                        <Slider Minimum="0" Maximum="64" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding GapValue}" AutomationProperties.Name="Gap between windows, 0 to 64 pixels"/>
                        <TextBlock Text="0–64 px on the slider. Larger values can be entered above." Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,20"/>
                        <CheckBox Content="Apply gap to screen _edges" IsChecked="{Binding ApplyGapToScreenEdges}"/>
                        <TextBlock Text="Adds spacing between tiled windows and the monitor work area edges." Foreground="{DynamicResource MutedBrush}" Margin="22,8,0,16"/>
                        <local:LayoutPreview Gap="{Binding GapValue}" Edges="{Binding ApplyGapToScreenEdges}" Height="160"/>
                        <TextBlock Text="Illustrative preview · two thirds + one third · spacing capped at 64 px" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,0" FontSize="12"/>
                    </StackPanel></Border>
                    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Repeated commands" Style="{StaticResource Heading}"/><TextBlock Text="Half shortcuts cycle sizes:"/><TextBlock Text="1/2 → 2/3 → 1/3" FontSize="20" Foreground="{DynamicResource AccentBrush}" Margin="0,10,0,8"/><TextBlock Text="Third, two-thirds and sixth shortcuts cycle horizontally in the same row." Foreground="{DynamicResource MutedBrush}"/></StackPanel></Border>
                </StackPanel></ScrollViewer>
            </TabItem>
            <TabItem Header="_General">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,8,12,0"><StackPanel>
                    <Border Style="{StaticResource Card}" DataContext="{Binding LoginStartup}"><StackPanel>
                        <TextBlock Text="Startup" Style="{StaticResource Heading}"/>
                        <CheckBox Content="Start PaneShift when I sign _in" IsChecked="{Binding IsEnabled, Mode=OneWay}" Command="{Binding ToggleCommand}" IsEnabled="{Binding CanChange}" AutomationProperties.Name="Start PaneShift when I sign in"/>
                        <TextBlock Text="Changes immediately · shared with the tray menu" Foreground="{DynamicResource MutedBrush}" Margin="22,8,0,8"/>
                        <TextBlock Text="{Binding Description}" Foreground="{DynamicResource MutedBrush}"/>
                        <TextBlock Text="{Binding Error}" Foreground="{DynamicResource ErrorBrush}" Margin="0,8,0,0"/>
                    </StackPanel></Border>
                    <Border Style="{StaticResource Card}"><StackPanel>
                        <TextBlock Text="Runtime" Style="{StaticResource Heading}"/>
                        <TextBlock Text="{Binding RuntimeStatus}" Margin="0,0,0,12"/>
                        <Button x:Name="ElevateButton" Content="Restart as administrator…" Click="Elevate" HorizontalAlignment="Left"/>
                        <TextBlock x:Name="ElevationHint" Foreground="{DynamicResource MutedBrush}" Margin="0,10,0,0"/>
                    </StackPanel></Border>
                    <Border Style="{StaticResource Card}"><StackPanel>
                        <TextBlock Text="Configuration" Style="{StaticResource Heading}"/>
                        <TextBlock x:Name="ConfigPath" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,12"/>
                        <WrapPanel><Button Content="Open settings file" Click="OpenFile" Margin="0,0,8,8"/><Button Content="Open configuration folder" Click="OpenFolder" Margin="0,0,0,8"/></WrapPanel>
                        <TextBlock Text="After editing JSON, use Reload Settings in the tray. Changes in this window take effect only when you Apply." Foreground="{DynamicResource MutedBrush}"/>
                    </StackPanel></Border>
                    <Border Style="{StaticResource Card}"><StackPanel>
                        <TextBlock Text="PaneShift" Style="{StaticResource Heading}"/><TextBlock x:Name="VersionLabel" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,12"/>
                        <Button Content="GitHub repository" Click="OpenRepository" HorizontalAlignment="Left"/>
                    </StackPanel></Border>
                    <Button Content="Restore defaults…" Click="RestoreDefaults" HorizontalAlignment="Left" Margin="0,0,0,16"/>
                </StackPanel></ScrollViewer>
            </TabItem>
        </TabControl>
        <Grid Grid.Row="3" Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0"><TextBlock Text="{Binding Validation}" Foreground="{DynamicResource ErrorBrush}"/><TextBlock Text="{Binding Feedback}"/></StackPanel>
            <Button Grid.Column="1" Content="_Cancel" Click="Cancel" MinWidth="90" Margin="0,0,8,0" VerticalAlignment="Bottom"/>
            <Button Grid.Column="2" Content="_Apply" Command="{Binding ApplyCommand}" MinWidth="90" Background="{DynamicResource AccentBrush}" Foreground="White" VerticalAlignment="Bottom"/>
        </Grid>
    </Grid>
</Window>
